{
  "name": "party-game-template",
  "private": true,
  "version": "1.0.0-alpha",
  "scripts": {
    "build": "npm run clean && vite build",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "lint:tsc": "tsc --project tsconfig.app.json",
    "prepare": "husky",
    "preview": "vite preview",
    "start": "vite --open"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/roboto": "5.3.0",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@reduxjs/toolkit": "2.14.0",
    "driftdb-react": "1.0.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-tsdoc": "0.5.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vite-plugin-html": "3.2.2"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  }
}
